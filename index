<!-- INÍCIO DO PLAYER DE RÁDIO -->
<div class="player-container">
    <div class="radio-info">
        <img src="logo-rosas.png" alt="Logo Rádio Rosas" class="radio-logo">
        <span class="status-live">● AO VIVO</span>
        <h3>Rádio Rosas - Paulista PE</h3>
        <p id="current-song">🎵 Tocando agora: Carregando...</p>
    </div>
    
    <audio id="radio-stream" src="https://zeno.fm"></audio>
    <button id="play-btn" onclick="togglePlay()">▶ OUVIR</button>
</div>

<style>
.player-container {
    background: linear-gradient(135deg, #ff0000, #ffeb3b);
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    padding: 20px;
    border-radius: 15px;
    width: 100%;
    max-width: 350px;
    text-align: center;
    color: #fff;
    box-shadow: 0 4px 15px rgba(0,0,0,0.2);
    margin: 20px auto;
    border: 3px solid #fff;
}
.radio-logo {
    width: 80px;
    height: auto;
    margin-bottom: 10px;
}
.status-live {
    font-size: 12px;
    background: #ff0000;
    padding: 3px 8px;
    border-radius: 20px;
    font-weight: bold;
    letter-spacing: 1px;
    color: #fff;
}
.radio-info h3 {
    margin: 10px 0 10px 0;
    font-size: 22px;
    font-weight: 700;
    color: #fff;
    text-shadow: 1px 1px 3px rgba(0,0,0,0.4);
}
#current-song {
    font-size: 14px;
    margin: 5px 0 15px 0;
    color: #fff;
    font-style: italic;
}
#play-btn {
    background: #fff;
    color: #ff0000;
    border: none;
    padding: 12px 35px;
    font-size: 16px;
    font-weight: bold;
    border-radius: 50px;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    width: 80%;
}
#play-btn:hover {
    transform: scale(1.05);
    background: #ffeb3b;
    color: #000;
}
</style>

<script>
function togglePlay() {
    var audio = document.getElementById('radio-stream');
    var btn = document.getElementById('play-btn');
    
    if (audio.paused) {
        audio.play();
        btn.innerHTML = "❚❚ PAUSAR";
        btn.style.background = "#ff0000";
        btn.style.color = "#fff";
    } else {
        audio.pause();
        audio.load(); 
        btn.innerHTML = "▶ OUVIR";
        btn.style.background = "#fff";
        btn.style.color = "#ff0000";
    }
}

// Exemplo de atualização da música atual (precisa de integração com API do streaming)
function updateSong() {
    // Aqui você pode integrar com a API do Zeno.fm ou outro serviço
    // Exemplo fictício:
    document.getElementById('current-song').innerText = "🎵 Tocando agora: Nome da Música";
}

// Atualiza a cada 10 segundos
setInterval(updateSong, 10000);
</script>
<!-- FIM DO PLAYER DE RÁDIO -->