<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Rádio Rosas - Paulista PE</title>
    <style>
        body {
            background: linear-gradient(135deg, #ff0000, #ffeb3b);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            color: #fff;
            text-align: center;
            margin: 0;
            padding: 0;
        }
        .player-container {
            padding: 20px;
            border-radius: 15px;
            max-width: 350px;
            margin: 40px auto;
            background: rgba(255,255,255,0.1);
            box-shadow: 0 4px 15px rgba(0,0,0,0.3);
        }
        .radio-logo {
            width: 100px;
            height: auto;
            border-radius: 50%;
            border: 3px solid #fff;
            margin-bottom: 10px;
        }
        .status-live {
            font-size: 12px;
            background: #ff0000;
            padding: 3px 8px;
            border-radius: 20px;
            font-weight: bold;
            letter-spacing: 1px;
            color: #fff;
        }
        h3 {
            margin: 10px 0;
            font-size: 22px;
            font-weight: 700;
            text-shadow: 1px 1px 3px rgba(0,0,0,0.4);
        }
        #current-song {
            font-size: 14px;
            margin: 5px 0 15px 0;
            font-style: italic;
        }
        #play-btn {
            background: #fff;
            color: #ff0000;
            border: none;
            padding: 12px 35px;
            font-size: 16px;
            font-weight: bold;
            border-radius: 50px;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
            width: 80%;
        }
        #play-btn:hover {
            transform: scale(1.05);
            background: #ffeb3b;
            color: #000;
        }
    </style>
</head>
<body>
    <div class="player-container">
        <img src="logo-rosas.png" alt="Logo Rádio Rosas" class="radio-logo">
        <span class="status-live">● AO VIVO</span>
        <h3>Rádio Rosas - Paulista PE</h3>
        <p id="current-song">🎵 Tocando agora: Carregando...</p>
        <audio id="radio-stream" src="https://stream.zeno.fm/SEU_STREAM_ID"></audio>
        <button id="play-btn" onclick="togglePlay()">▶ OUVIR</button>
    </div>

    <script>
        function togglePlay() {
            var audio = document.getElementById('radio-stream');
            var btn = document.getElementById('play-btn');
            if (audio.paused) {
                audio.play();
                btn.innerHTML = "❚❚ PAUSAR";
                btn.style.background = "#ff0000";
                btn.style.color = "#fff";
            } else {
                audio.pause();
                audio.load();
                btn.innerHTML = "▶ OUVIR";
                btn.style.background = "#fff";
                btn.style.color = "#ff0000";
            }
        }

        async function updateSong() {
            try {
                const response = await fetch("https://api.zeno.fm/stations/SEU_STREAM_ID/now_playing");
                const data = await response.json();
                if (data && data.title) {
                    document.getElementById('current-song').innerText = "🎵 Tocando agora: " + data.title;
                }
            } catch (error) {
                console.error("Erro ao buscar música:", error);
            }
        }

        setInterval(updateSong, 15000);
        updateSong();
    </script>
</body>
</html>